# Copy to .env and fill in real values. Never commit the real .env file.
SECRET_KEY=change-me-to-a-long-random-string
MOTOSIRA_USER=admin
# Preferred: a werkzeug password hash generated once via:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('yourpassword'))"
MOTOSIRA_PASS_HASH=
# Fallback (plaintext, hashed automatically at startup) — only used if
# MOTOSIRA_PASS_HASH above is empty. Fine for local dev, avoid in the field.
MOTOSIRA_PASS=motosira123

# MQTT broker host. PC: localhost. Pi: the dashboard PC's LAN IP.
MOTOSIRA_BROKER=localhost
# INMP441 channel count requested first (auto-falls back to 2 if needed)
MOTOSIRA_MIC_CHANNELS=1
